<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!--
        CT_CONSTRUCTOR_THROW: Constructor throws exception

        These are intentional for protocol message classes where constructor
        validation ensures only valid objects are created. Throwing from
        constructor is the correct behavior for invalid input.
    -->

    <!-- Protocol message classes - validation in constructor is intentional -->
    <Match>
        <Package name="su.kidoz.kaillera.controller.v086.protocol"/>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>

    <!-- FileBasedAccessManager - file I/O exceptions are expected -->
    <Match>
        <Class name="su.kidoz.kaillera.access.FileBasedAccessManager"/>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>

    <!-- Network classes - socket exceptions are expected -->
    <Match>
        <Class name="~su\.kidoz\.net\..*"/>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>

    <!-- Controller classes - initialization exceptions are expected -->
    <Match>
        <Class name="su.kidoz.kaillera.controller.connectcontroller.ConnectController"/>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>

    <!--
        Test source exclusions - these are acceptable patterns in test code.
        RV_RETURN_VALUE_IGNORED_NO_SIDE_EFFECT stays enabled: a test that
        ignores a result with no side effect is usually a missing assertion.
    -->
    <Match>
        <Source name="~.*Test\.java"/>
        <Bug pattern="RV_RETURN_VALUE_IGNORED_BAD_PRACTICE,DLS_DEAD_LOCAL_STORE,RV_RETURN_VALUE_IGNORED,BC_VACUOUS_INSTANCEOF,REC_CATCH_EXCEPTION"/>
    </Match>

    <!--
        EI_EXPOSE_REP / EI_EXPOSE_REP2: May expose internal representation.

        Configuration, DTO, and model classes return their fields directly
        because callers in this process share those objects. Other packages
        stay checked.
    -->
    <Match>
        <Or>
            <Package name="su.kidoz.config"/>
            <Package name="su.kidoz.kaillera.admin.dto"/>
            <Package name="~su\.kidoz\.kaillera\.model(\..*)?"/>
        </Or>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!--
        Constructors keep the collaborator they were given. Copying a server,
        controller, client, or collector would be a different object.
        InetAddress is immutable, and SpotBugs still treats it as mutable.
    -->
    <Match>
        <Or>
            <Class name="su.kidoz.kaillera.admin.AdminRestController"/>
            <Class name="su.kidoz.kaillera.admin.AdminApiClient"/>
            <Class name="su.kidoz.kaillera.controller.connectcontroller.ConnectController"/>
            <Class name="su.kidoz.kaillera.controller.v086.V086ClientHandler"/>
            <Class name="su.kidoz.kaillera.controller.v086.V086Controller"/>
            <Class name="su.kidoz.kaillera.master.client.EmuLinkerMasterUpdateTask"/>
            <Class name="su.kidoz.kaillera.master.client.KailleraMasterUpdateTask"/>
            <Class name="su.kidoz.kaillera.master.client.MasterListUpdaterImpl"/>
            <Class name="su.kidoz.kaillera.metrics.ServerMetrics"/>
            <Class name="su.kidoz.kaillera.service.ChatModerationService"/>
            <Class name="su.kidoz.kaillera.service.impl.GameServiceImpl"/>
            <Class name="su.kidoz.kaillera.service.impl.UserServiceImpl"/>
            <Class name="su.kidoz.net.PrivateUDPServer"/>
        </Or>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!--
        These getters hand back the shared object callers already use:
        session caches, the logged-in user, metrics, and the bound address.
    -->
    <Match>
        <Or>
            <Class name="su.kidoz.kaillera.controller.v086.V086ClientHandler"/>
            <Class name="su.kidoz.kaillera.metrics.ServerMetrics"/>
            <Class name="su.kidoz.net.PrivateUDPServer"/>
            <Class name="su.kidoz.net.UDPServer"/>
            <Class name="su.kidoz.kaillera.load.MockKailleraClient"/>
        </Or>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>

    <Match>
        <Class name="su.kidoz.kaillera.controller.v086.V086Controller"/>
        <Method name="getServer"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
</FindBugsFilter>
