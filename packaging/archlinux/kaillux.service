[Unit]
Description=Kaillux Kaillera Server
Documentation=https://github.com/kidoz/kaillux
After=network.target

[Service]
Type=simple
User=kaillux
Group=kaillux

# Java options come from the launcher's defaults (-Xms64m -Xmx256m and
# -XX:+UseCompactObjectHeaders). To change them, add a drop-in instead of
# editing this file:
#   systemctl edit kaillux
#   [Service]
#   Environment="KAILLUX_OPTS=-Xms64m -Xmx512m -XX:+UseCompactObjectHeaders"

# Working directory for logs
WorkingDirectory=/var/lib/kaillux

# Start command
ExecStart=/usr/bin/kaillux

# Restart on failure
Restart=on-failure
RestartSec=10

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
# The server binds only ports above 1024, so it needs no capability at all.
CapabilityBoundingSet=

# Allow write to working directory and logs
ReadWritePaths=/var/lib/kaillux

# Network access
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
