<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Console Appender: the only one enabled by default. -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{MM-dd-yy HH:mm:ss.SSS} %5p %c{1}: %m%n</pattern>
        </encoder>
    </appender>

    <!-- File logging (disabled).
         To enable it, remove the comment markers around both appenders and around
         the ASYNC_FILE appender-ref of the root logger. An appender that is defined
         but not referenced makes logback print its configuration status at startup. -->
    <!--
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>kaillux.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>kaillux.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>5</maxHistory>
            <totalSizeCap>100MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{MM-dd-yy HH:mm:ss.SSS} %5p %c{1}: %m%n</pattern>
        </encoder>
    </appender>

    <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>512</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <includeCallerData>false</includeCallerData>
        <appender-ref ref="FILE"/>
    </appender>
    -->

    <!-- Spring Framework -->
    <logger name="org.springframework" level="INFO"/>
    <logger name="org.springframework.web" level="INFO"/>
    <logger name="org.springframework.boot" level="INFO"/>

    <!-- Hibernate/JPA (if used in future) -->
    <logger name="org.hibernate" level="WARN"/>

    <!-- Kaillux loggers.
         DEBUG is verbose: it records per-packet events on the ports that anyone
         can reach, so enable it only while diagnosing a problem, for example with
         <logger name="su.kidoz.kaillera.controller" level="DEBUG"/> -->
    <logger name="su.kidoz.kaillera.master" level="INFO"/>

    <!-- Root logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <!-- <appender-ref ref="ASYNC_FILE"/> -->
    </root>
</configuration>
